# Copy this file to .env for local runs.
# Never put real API keys in tracked files.

# Optional if using Capriole-backed LLM orchestration.
CAPRIOLE_API_KEY="your_capriole_key_here"

# Local GPU Whisper transcription.
# This default can be overridden for one run with:
# python transcriber.py --backend groq
# python transcriber.py --backend whisper
TRANSCRIPTION_BACKEND=whisper
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda

# Online multilingual speech -> English text for StreamDiffusion prompts.
# Keep the real key only in .env or your shell environment.
# TRANSCRIPTION_BACKEND=groq
# GROQ_API_KEY="your_groq_key_here"
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# GROQ_TRANSCRIPTION_INTERVAL=5.0
# GROQ_MIN_AUDIO_SECONDS=2.0
# GROQ_MAX_AUDIO_SECONDS=5.0

# Recognition-only online experiment. Does not translate to English.
# TRANSCRIPTION_BACKEND=google
# GOOGLE_SPEECH_LANGUAGE=en-US
# GOOGLE_SPEECH_CHINESE_LANGUAGE=zh-CN
# GOOGLE_SPEECH_SPANISH_LANGUAGE=es-ES
